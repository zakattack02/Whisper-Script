<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Exclude runtime-specific native libraries to prevent BadImageFormatException -->
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference Jellyfin assemblies without copying them (provided by Jellyfin) -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.2">
      <PrivateAssets>All</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.2">
      <PrivateAssets>All</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    
    <!-- Include Whisper.net assemblies -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <!-- Exclude wrong-platform runtime libraries after publish -->
  <Target Name="RemoveWrongRuntimeLibraries" AfterTargets="Publish">
    <ItemGroup>
      <RuntimeFoldersToRemove Include="$(PublishDir)runtimes\win-*" Condition="'$(OS)' != 'Windows_NT'" />
      <RuntimeFoldersToRemove Include="$(PublishDir)runtimes\linux-*" Condition="'$(OS)' == 'Windows_NT'" />
      <RuntimeFoldersToRemove Include="$(PublishDir)runtimes\osx-*" Condition="'$(OS)' != 'Unix' OR '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' != 'true'" />
    </ItemGroup>
    <RemoveDir Directories="@(RuntimeFoldersToRemove)" />
    <Message Text="Removed platform-specific runtime folders: @(RuntimeFoldersToRemove)" Importance="high" />
  </Target>

</Project>
