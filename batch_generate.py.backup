#!/usr/bin/env python3
"""
Whisper Subtitle Generator for Jellyfin
Automatically generate subtitles for your media library using OpenAI's Whisper.

Usage:
    python batch_generate.py                    # Use configured folders
    python batch_generate.py /path/to/media     # Process specific folder
    python batch_generate.py --help             # Show all options
"""

import os
import sys
import argparse
from pathlib import Path
import whisper
from tqdm import tqdm

# ============================================================================
# CONFIGURATION - Edit these paths to match your Jellyfin media folders
# ============================================================================

MEDIA_FOLDERS = [
    # Add your Jellyfin media folder paths here
    # "/path/to/jellyfin/Movies",
    # "/path/to/jellyfin/TV Shows",
    # "/path/to/jellyfin/Anime",

    
    #"/mnt/jellyfin/anime/",
    #"/mnt/jellyfin/anime_movies/",
    "/mnt/jellyfin/XXX/",

]

# Whisper model to use (tiny, base, small, medium, large)
MODEL = "small"

# Subtitle format (srt, vtt, txt, json)
FORMAT = "srt"

# Target language code (e.g., 'en', 'es', 'fr', 'ja', 'ko')
LANGUAGE = "en"

# Translation mode: True = translate to English, False = transcribe in original language
TRANSLATE = True

# AI identifier to mark generated subtitles (e.g., 'whisper', 'ai', 'auto', or '' to disable)
# Results in filenames like: video.en.whisper.srt
AI_IDENTIFIER = "whisper"

# Regenerate AI-generated subtitles even if they already exist
REGENERATE_AI = False

# Set to True to preview without processing
DRY_RUN = False

# ============================================================================
# Script - No need to edit below this line
# ============================================================================

def main():
    if not MEDIA_FOLDERS:
        print("ERROR: No media folders configured!")
        print("Edit this script and add your Jellyfin media folder paths to MEDIA_FOLDERS")
        sys.exit(1)
    
    # Validate folders exist
    valid_folders = []
    for folder in MEDIA_FOLDERS:
        folder_path = Path(folder)
        if folder_path.exists():
            valid_folders.append(folder)
        else:
            print(f"Warning: Folder not found: {folder}")
    
    if not valid_folders:
        print("ERROR: No valid media folders found!")
        sys.exit(1)
    
    print("=" * 70)
    print("BATCH SUBTITLE GENERATOR")
    print("=" * 70)
    print(f"Model: {MODEL}")
    print(f"Format: {FORMAT}")
    print(f"Language: {LANGUAGE}")
    print(f"Mode: {'Translation to English' if TRANSLATE else 'Transcription'}")
    print(f"AI Identifier: {AI_IDENTIFIER if AI_IDENTIFIER else '(none)'}")
    print(f"Regenerate AI: {REGENERATE_AI}")
    print(f"Dry Run: {DRY_RUN}")
    print(f"Folders to process: {len(valid_folders)}")
    print()
    
    # Process each folder
    total_success = 0
    total_failed = 0
    total_interrupted = 0
    
    try:
        for i, folder in enumerate(valid_folders, 1):
            print(f"\n{'=' * 70}")
            print(f"Processing folder {i}/{len(valid_folders)}: {folder}")
            print("=" * 70)
            
            # Build command
            cmd = [
                sys.executable,
                "generate_subtitles.py",
                folder,
                "--model", MODEL,
                "--format", FORMAT,
                "--language", LANGUAGE
            ]
            
            if TRANSLATE:
                cmd.append("--translate")
            
            if AI_IDENTIFIER:
                cmd.extend(["--identifier", AI_IDENTIFIER])
            
            if REGENERATE_AI:
                cmd.append("--regenerate-ai")
            
            if DRY_RUN:
                cmd.append("--dry-run")
            
            # Run the script
            try:
                result = subprocess.run(cmd, check=True)
                total_success += 1
            except subprocess.CalledProcessError as e:
                print(f"\n⚠ Error processing {folder}")
                print(f"Exit code: {e.returncode}")
                total_failed += 1
    except KeyboardInterrupt:
        print("\n\n⚠ Interrupted by user!")
        total_interrupted = len(valid_folders) - (total_success + total_failed)
    
    # Final summary
    print("\n" + "=" * 70)
    print("BATCH PROCESSING COMPLETE")
    print("=" * 70)
    print(f"Total folders to process: {len(valid_folders)}")
    print(f"Successful: {total_success}")
    print(f"Failed: {total_failed}")
    if total_interrupted > 0:
        print(f"Skipped/Interrupted: {total_interrupted}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\nBatch processing interrupted by user. Exiting...")
        sys.exit(130)
